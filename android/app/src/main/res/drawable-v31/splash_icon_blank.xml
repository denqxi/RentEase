<?xml version="1.0" encoding="utf-8"?>
<!--
  A fully transparent 1x1dp shape used as the Android 12+ splash screen icon.
  Android's SplashScreen API always requires an icon drawable — this one is
  invisible, so the splash reduces to a plain white flash that immediately
  hands off to the app's own splash_screen.dart, instead of showing the
  stock Flutter launcher icon.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <size android:width="1dp" android:height="1dp" />
    <solid android:color="@android:color/transparent" />
</shape>
